            "rating": 4.6,
            "badge": "Best value",
            "specs": [
              "Adaptive noise cancelling",
              "40 h battery"
            ],
            "onAction": {
              "event": {
                "name": "add_to_cart",
                "context": {
                  "sku": "studio"
                }
              }
            }
          },
          {
            "id": "p2",
            "component": "ProductCard",
            "name": "Aria Pro 2",
            "price": "$349",
            "rating": 4.8,
            "badge": "Top rated",
            "specs": [
              "Best-in-class ANC",
              "Spatial audio"
            ],
            "onAction": {
              "event": {
                "name": "add_to_cart",
                "context": {
                  "sku": "aria"
                }
              }
            }
          },
          {
            "id": "p3",
            "component": "ProductCard",
            "name": "Fold Lite",
            "price": "$129",
            "rating": 4.2,
            "specs": [
              "Foldable, 190 g",
              "50 h battery"
            ],
            "onAction": {
              "event": {
                "name": "add_to_cart",
                "context": {
                  "sku": "fold"
                }
              }
            }
          }
        ]
      }
    }
  ],
