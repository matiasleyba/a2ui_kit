[
  [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "sales-dashboard",
        "catalogId": "https://copilotkit.ai/a2ui/catalogs/playground/v1",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "gap": 3,
            "children": [
              "head",
              "kpis",
              "chart",
              "form",
              "note"
            ]
          },
          {
            "id": "head",
            "component": "Heading",
            "text": "Q3 sales by region",
            "eyebrow": "Sales dashboard",
            "subtitle": "Revenue grew 11% on EMEA renewals"
          },
          {
            "id": "kpis",
            "component": "Grid",
            "columns": 3,
            "children": [
              "k1",
              "k2",
              "k3"
            ]
          },
          {
            "id": "k1",
            "component": "Stat",
            "label": "Revenue",
            "value": "$18.4M",
            "delta": "+11.2%",
            "trend": "up"
          },
          {
            "id": "k2",
            "component": "Stat",
            "label": "Units sold",
            "value": "128k",
            "delta": "+8.4%",
            "trend": "up"
          },
          {
            "id": "k3",
            "component": "Stat",
            "label": "Quota attainment",
            "value": "104%",
            "delta": "+3 pts",
            "trend": "up"
          },
          {
            "id": "chart",
            "component": "BarChart",
            "title": "Revenue by region",
            "format": "currency",
            "data": [
              {
                "x": "NA",
                "y": 7.1
              },
              {
                "x": "EMEA",
                "y": 5.2
              },
              {
                "x": "APAC",
                "y": 3.9
              },
              {
                "x": "LATAM",
                "y": 2.2
              }
            ]
          },
          {
            "id": "form",
            "component": "Card",
            "children": [
              "ft",
              "email",
              "send"
            ]
          },
          {
            "id": "ft",
            "component": "Title",
            "text": "Get the weekly report",
            "size": "md"
          },
          {
            "id": "email",
            "component": "TextField",
            "label": "Work email",
            "value": {
              "@path": "/form/email"
            }
          },
          {
            "id": "send",
            "component": "Button",
            "label": "Subscribe",
            "variant": "primary",
            "onClick": {
              "event": {
                "name": "subscribe",
                "context": {
                  "email": {
                    "@path": "/form/email"
                  }
                }
              }
            }
          },
          {
            "id": "note",
            "component": "Caption",
            "text": "Illustrative data"
          }
        ],
        "dataModel": {
          "form": {
            "email": ""
          }
        }
      }
    }
  ],
  [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "product-comparison",
        "catalogId": "https://copilotkit.ai/a2ui/catalogs/playground/v1",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "gap": 3,
            "children": [
              "head",
              "grid"
            ]
          },
          {
            "id": "head",
            "component": "Heading",
            "text": "Noise-cancelling headphones",
            "eyebrow": "Compare",
            "subtitle": "Three picks under $400, best value first"
          },
          {
            "id": "grid",
            "component": "Grid",
            "columns": 3,
            "children": [
              "p1",
              "p2",
              "p3"
            ]
          },
          {
            "id": "p1",
            "component": "ProductCard",
            "name": "Studio Wireless",
            "price": "$249",
